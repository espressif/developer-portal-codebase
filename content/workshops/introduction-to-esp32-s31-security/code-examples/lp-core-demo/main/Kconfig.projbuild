menu "LP-Core Pulse Counter Demo"

    config DEMO_HP_HOLD_TIME_MS
        int "HP-only measurement interval (ms)"
        range 1000 60000
        default 10000
        help
            Time to keep the HP domain running after Wi-Fi shuts down and
            before starting the LP core.

    config DEMO_PULSE_INTERVAL_MS
        int "Simulated pulse interval (ms)"
        range 10 60000
        default 1000
        help
            Time between LP timer counts and GPIO marker pulses.

    config DEMO_PULSES_PER_WAKEUP
        int "Pulses required to wake the HP core"
        range 1 1000000
        default 30
        help
            The LP core wakes the HP core after counting this many pulses.

    config DEMO_TRACE_GPIO
        int "GPIO for LP pulse tracing"
        range 0 7
        default 4
        help
            RTC GPIO driven high briefly after every LP count.
            GPIO4 is exposed as J2 pin 32 on the Function-CoreBoard-1.

    config DEMO_TRACE_PULSE_WIDTH_MS
        int "GPIO trace pulse width (ms)"
        range 1 100
        default 1
        help
            GPIO remains low between counts and goes high for this duration
            whenever an LP count occurs.

endmenu
