menu "LP-Core Pulse Counter Demo"

    config DEMO_HP_HOLD_TIME_MS
        int "HP-only measurement interval (ms)"
        range 1000 60000
        default 10000
        help
            Time to keep the HP domain running after Wi-Fi shuts down and
            before starting the LP core.

    config DEMO_PULSE_INTERVAL_MS
        int "Simulated pulse interval (ms)"
        range 10 60000
        default 1000
        help
            Time between LP timer wakeups. Each wakeup is counted as one
            simulated button press.

    config DEMO_PULSES_PER_WAKEUP
        int "Pulses required to wake the HP core"
        range 1 1000000
        default 30
        help
            The LP core wakes the HP core after counting this many pulses.

endmenu
